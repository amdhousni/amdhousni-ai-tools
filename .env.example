# ---------------------------------------------------------------------------
# amdhousni-ai-tools — environment variables
#
# Everything here is optional. With no LLM_API_KEY the tools run their
# deterministic engines and say so in the interface; with no REDIS_URL the rate
# limiter is per process.
#
# Copy to `.env.local` inside apps/web (Next.js reads it there) and never commit
# real values.
# ---------------------------------------------------------------------------

# --- Model provider (server-only) ------------------------------------------
# Any OpenAI-compatible chat-completions provider: OpenAI, OpenRouter, Groq,
# DeepSeek, Qwen, Gemini's compatibility endpoint.
LLM_API_KEY=
# Default: https://api.openai.com/v1
LLM_BASE_URL=
# Default: gpt-4o-mini
LLM_MODEL=
# Hard abort for a provider call, in milliseconds. Default: 15000.
LLM_TIMEOUT_MS=
# Optional. Enables cosine retrieval in the RAG inspector; without it the tool
# uses BM25 and labels the mode accordingly.
LLM_EMBEDDINGS_MODEL=

# --- Rate limiting ----------------------------------------------------------
# redis:// or rediss:// URL. When set, the sliding window is shared across
# instances; when absent (or unreachable) the limiter stays in memory.
REDIS_URL=
# Requests per IP per window. Default: 20.
RATE_LIMIT_MAX=
# Window length in seconds. Default: 300.
RATE_LIMIT_WINDOW_SECONDS=

# --- Links (inlined at build time) ------------------------------------------
# Portfolio origin, used for canonical URLs and the Hire Me / live-tools links.
NEXT_PUBLIC_SITE_URL=https://amdhousni.com
# Public repository, used by every "View source on GitHub" link.
NEXT_PUBLIC_REPO_URL=https://github.com/amdhousni/amdhousni-ai-tools
